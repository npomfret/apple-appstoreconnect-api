{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "WebSearch",
      "WebFetch",
      "mcp__gitnexus",
      "mcp__webstorm"
    ],
    "deny": [
      "mcp__webstorm__execute_terminal_command",
      "mcp__webstorm__execute_run_configuration",
      "mcp__webstorm__execute_tool",
      "mcp__webstorm__run_inspection_kts",
      "mcp__webstorm__build_project",
      "mcp__webstorm__apply_patch",
      "mcp__webstorm__create_new_file",
      "mcp__webstorm__reformat_file",
      "Bash(git push *)",
      "Bash(* --yes *)",
      "Bash(*--yes)",
      "Read(session.json)",
      "Edit(session.json)",
      "Read(**/*.session.json)",
      "Edit(**/*.session.json)",
      "Read(tmp/curl.txt)",
      "Edit(tmp/curl.txt)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "env": {
    "NODE_USE_ENV_PROXY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "teamcity@npomfret": true,
    "task-files@npomfret": true,
    "webstorm@npomfret": true,
    "auditing@npomfret": true
  },
  "enabledMcpjsonServers": ["gitnexus", "webstorm"]
}
