{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git *)",
      "Bash(npm run *)",
      "Bash(python3 scripts/teamcity.py *)",
      "Bash(./scripts/teamcity.py *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(* --yes *)",
      "Bash(*--yes)",
      "Read(session.json)",
      "Edit(session.json)",
      "Read(**/*.session.json)",
      "Edit(**/*.session.json)",
      "Read(tmp/curl.txt)",
      "Edit(tmp/curl.txt)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(dist/**)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "teamcity@npomfret": true
  }
}
