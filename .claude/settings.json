{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(* --yes *)",
      "Bash(*--yes)",
      "Read(session.json)",
      "Edit(session.json)",
      "Read(**/*.session.json)",
      "Edit(**/*.session.json)",
      "Read(tmp/curl.txt)",
      "Edit(tmp/curl.txt)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(dist/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git fetch *",
      "git pull *",
      "git push *",
      "git ls-remote *",
      "git clone *",
      "gh *",
      "python3 scripts/teamcity.py *"
    ],
    "network": {
      "allowedDomains": [
        "*"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache",
        "~/Library/Caches",
        "~/Library/Developer/Xcode/DerivedData",
        "/var/folders"
      ]
    }
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "teamcity@npomfret": true,
    "task-files@npomfret": true
  }
}
